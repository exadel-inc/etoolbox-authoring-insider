<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="cq:Page">
    <metadataschema jcr:primaryType="sling:Folder">
        <default jcr:primaryType="sling:Folder">
            <image jcr:primaryType="sling:Folder">
                <items jcr:primaryType="nt:unstructured">
                    <tabs jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <tabEai jcr:primaryType="nt:unstructured"
                                    jcr:title="Authoring Insider"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    granite:rel="aem-assets-metadata-form-tab">
                                <items jcr:primaryType="nt:unstructured">
                                    <col1 jcr:primaryType="nt:unstructured"
                                          sling:resourceType="granite/ui/components/coral/foundation/container"
                                          granite:rel="aem-assets-metadata-form-column">
                                        <items jcr:primaryType="nt:unstructured">
                                            <eaiCaption
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Image Caption (Alt Text)"
                                                name="./jcr:content/metadata/eai.caption"/>
                                        </items>
                                    </col1>
                                    <col2 jcr:primaryType="nt:unstructured"
                                          sling:resourceType="granite/ui/components/coral/foundation/container"
                                          granite:rel="aem-assets-metadata-form-column">
                                        <items jcr:primaryType="nt:unstructured"/>
                                    </col2>
                                </items>
                            </tabEai>
                        </items>
                    </tabs>
                </items>
            </image>
        </default>
    </metadataschema>
</jcr:root>